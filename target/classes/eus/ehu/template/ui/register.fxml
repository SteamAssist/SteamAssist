<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="450.0" minWidth="800.0"
            style="-fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef);"
            stylesheets="@../../../../bootstrapfx.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eus.ehu.template.ui.RegisterController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <Separator style="-fx-background-color: #dee2e6;" prefHeight="2.0" />
            <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: linear-gradient(to right, #343a40, #495057); -fx-padding: 12; -fx-spacing: 20;">
                <padding>
                    <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
                </padding>
                <Button fx:id="back" mnemonicParsing="false" onAction="#back" onMouseEntered="#handleMouseEnter2" onMouseExited="#handleMouseExit2"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 5;" text="HOME">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                    <effect>
                        <DropShadow color="#00000066" height="5.0" radius="2.0" width="5.0" />
                    </effect>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="createAccount" prefHeight="45.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="CREATE YOUR ACCOUNT">
                    <font>
                        <Font size="32.0" />
                    </font>
                    <effect>
                        <DropShadow color="#00000080" height="10.0" radius="4.5" width="10.0" />
                    </effect>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
            <Separator style="-fx-background-color: #dee2e6;" prefHeight="2.0" />
        </VBox>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
            </padding>
            <VBox alignment="CENTER" spacing="20.0" styleClass="card"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ced4da; -fx-border-width: 1;" HBox.hgrow="NEVER">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                </padding>
                <effect>
                    <DropShadow color="#00000040" height="20.0" radius="9.5" width="20.0" />
                </effect>
                <ImageView fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../../../../Icon.jpeg"/>
                </ImageView>
                <ImageView fitHeight="66.0" fitWidth="104.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../../../../logo.png"/>
                </ImageView>
                <Label text="Copilot Fanboys" style="-fx-text-fill: #495057;">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Label>
                <Label fx:id="YourTGC" text="Your trusted gaming companion" style="-fx-text-fill: #6c757d; -fx-font-style: italic;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox alignment="CENTER" spacing="25.0" styleClass="card"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ced4da; -fx-border-width: 1;" HBox.hgrow="SOMETIMES">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                </padding>
                <effect>
                    <DropShadow color="#00000040" height="20.0" radius="9.5" width="20.0" />
                </effect>
                <Label fx:id="Userinfo" text="User Information" style="-fx-text-fill: #343a40; -fx-font-weight: bold;">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
                <Separator prefWidth="200.0" />
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label fx:id="UsernameLabel" minWidth="120.0" text="Username:" style="-fx-text-fill: #495057; -fx-font-weight: bold;">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <TextField fx:id="username" maxWidth="250.0" prefHeight="35.0"
                               promptText="Choose a username"
                               style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ced4da; -fx-border-width: 1;" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label fx:id="passwordLabel" minWidth="120.0" text="Password:" style="-fx-text-fill: #495057; -fx-font-weight: bold;">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <StackPane HBox.hgrow="ALWAYS">
                        <HBox fx:id="hbox1" prefHeight="35.0" visible="false">
                            <TextField fx:id="passwordTextField" maxWidth="250.0" minWidth="0.0"
                                       prefHeight="35.0" promptText="Enter your password"
                                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ced4da; -fx-border-width: 1;" visible="false" HBox.hgrow="ALWAYS"/>
                            <ImageView fx:id="eye_closed" fitHeight="36.0" fitWidth="27.0"
                                       onMouseClicked="#togglePasswordVisibility"
                                       onMouseEntered="#eyeenter" onMouseExited="#eyeexit"
                                       pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                                <Image url="@../../../../eye_closed.png"/>
                            </ImageView>
                        </HBox>
                        <HBox fx:id="hbox2" prefHeight="35.0">
                            <PasswordField fx:id="password" maxWidth="250.0" minWidth="0.0"
                                           prefHeight="35.0" promptText="Enter your password"
                                           style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ced4da; -fx-border-width: 1;" HBox.hgrow="ALWAYS"/>
                            <ImageView fx:id="eye" fitHeight="36.0" fitWidth="27.0"
                                       onMouseClicked="#togglePasswordVisibility"
                                       onMouseEntered="#eyeenter" onMouseExited="#eyeexit"
                                       pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                                <Image url="@../../../../eye.png"/>
                            </ImageView>
                        </HBox>
                    </StackPane>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label fx:id="confirm" minWidth="120.0" text="Confirm:" style="-fx-text-fill: #495057; -fx-font-weight: bold;">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <StackPane HBox.hgrow="ALWAYS">
                        <HBox fx:id="hbox3" prefHeight="35.0" visible="false">
                            <TextField fx:id="passwordTextField1" maxWidth="250.0" minWidth="0.0"
                                       prefHeight="35.0" promptText="Confirm password"
                                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ced4da; -fx-border-width: 1;" visible="false" HBox.hgrow="ALWAYS"/>
                            <ImageView fx:id="eye_closed1" fitHeight="36.0" fitWidth="27.0"
                                       onMouseClicked="#togglePasswordVisibility1"
                                       onMouseEntered="#eyeenter" onMouseExited="#eyeexit"
                                       pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                                <Image url="@../../../../eye_closed.png"/>
                            </ImageView>
                        </HBox>
                        <HBox fx:id="hbox4" prefHeight="35.0">
                            <PasswordField fx:id="password1" maxWidth="250.0" minWidth="0.0"
                                           prefHeight="35.0" promptText="Confirm password"
                                           style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ced4da; -fx-border-width: 1;" HBox.hgrow="ALWAYS"/>
                            <ImageView fx:id="eye1" fitHeight="36.0" fitWidth="27.0"
                                       onMouseClicked="#togglePasswordVisibility1"
                                       onMouseEntered="#eyeenter" onMouseExited="#eyeexit"
                                       pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                                <Image url="@../../../../eye.png"/>
                            </ImageView>
                        </HBox>
                    </StackPane>
                </HBox>
                <Separator prefWidth="200.0" />
                <Button fx:id="signup" maxWidth="300.0" mnemonicParsing="false" onAction="#signup"
                        onMouseEntered="#signupenter" onMouseExited="#signupexit" prefHeight="45.0"
                        style="-fx-background-color: #d32f2f; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8;" text="CREATE ACCOUNT">
                    <font>
                        <Font size="16.0" />
                    </font>
                    <effect>
                        <DropShadow color="#00000066" height="8.0" radius="3.5" width="8.0" />
                    </effect>
                </Button>
                <HBox alignment="CENTER" spacing="10.0">
                    <Label fx:id="AlreadyHA" text="Already have an account?" style="-fx-text-fill: #6c757d;">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Button fx:id="back1" mnemonicParsing="false" onAction="#back1" onMouseEntered="#back1enter"
                            onMouseExited="#back1exited"
                            style="-fx-background-color: transparent; -fx-text-fill: #007bff; -fx-underline: true; -fx-cursor: hand;"
                            text="Log in here">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Button>
                </HBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #343a40;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label fx:id="AllRights" text="© 2025 Copilot Fanboys - All Rights Reserved" style="-fx-text-fill: #adb5bd;">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </HBox>
    </bottom>
</BorderPane>