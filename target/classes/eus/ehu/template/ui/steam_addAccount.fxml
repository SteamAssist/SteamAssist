<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<?import javafx.scene.image.Image?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="277.0" minWidth="500.0" prefHeight="450.0" prefWidth="720.0"
            style="-fx-background-color: linear-gradient(to bottom, #1b2838, #2a475e);"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.template.ui.SteamAddAccountController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #171a21; -fx-padding: 12px;" BorderPane.alignment="CENTER">
            <Button fx:id="back" mnemonicParsing="false" onAction="#back" onMouseEntered="#handleMouseEnter3" onMouseExited="#handleMouseExit3"
                    prefHeight="34.0" prefWidth="90.0"
                    style="-fx-background-color: #66c0f4; -fx-text-fill: #ffffff; -fx-background-radius: 4px; -fx-font-weight: bold; -fx-cursor: hand;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../../../atras.png"/>
                    </ImageView>
                </graphic>
                <HBox.margin>
                    <Insets left="10.0" />
                </HBox.margin>
                <effect>
                    <DropShadow color="#00000080" height="5.0" radius="2.0" width="5.0" />
                </effect>
            </Button>
            <Label fx:id="AddSteamAccout" alignment="CENTER" maxWidth="1.7976931348623157E308" text="Add Steam Account"
                   style="-fx-text-fill: #ffffff;" HBox.hgrow="ALWAYS">
                <font>
                    <Font name="System Bold" size="22.0" />
                </font>
                <HBox.margin>
                    <Insets right="100.0" />
                </HBox.margin>
            </Label>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="24.0" BorderPane.alignment="CENTER" style="-fx-background-color: transparent;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <HBox alignment="CENTER" spacing="15.0">
                <VBox alignment="CENTER" spacing="18.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #2a3f5a; -fx-background-radius: 8px; -fx-padding: 20px;">
                    <effect>
                        <DropShadow color="#00000060" height="10.0" radius="4.5" width="10.0" />
                    </effect>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label fx:id="Accountname" prefHeight="20.0" prefWidth="165.0" text="Account name:" style="-fx-text-fill: #c7d5e0; -fx-font-weight: bold;" />
                        <TextField fx:id="Accountnamefield" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #316282; -fx-text-fill: white; -fx-background-radius: 4px; -fx-border-color: #66c0f4; -fx-border-radius: 4px; -fx-padding: 8px;" />
            <HBox alignment="CENTER" spacing="10.0">
                <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefHeight="17.0" prefWidth="165.0" text="Account name:" />
                        <TextField fx:id="Accountnamefield" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label fx:id="SteamID" prefHeight="20.0" prefWidth="165.0" text="Steam ID:" style="-fx-text-fill: #c7d5e0; -fx-font-weight: bold;" />
                        <TextField fx:id="id" prefHeight="25.0" prefWidth="483.0" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #316282; -fx-text-fill: white; -fx-background-radius: 4px; -fx-border-color: #66c0f4; -fx-border-radius: 4px; -fx-padding: 8px;" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefHeight="17.0" prefWidth="165.0" text="Steam ID:" />
                        <TextField fx:id="id" prefHeight="25.0" prefWidth="483.0" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label fx:id="APIkey" prefHeight="20.0" prefWidth="165.0" text="SteamAPI key (optional):" style="-fx-text-fill: #c7d5e0; -fx-font-weight: bold;" />
                        <TextField fx:id="apikey" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #316282; -fx-text-fill: white; -fx-background-radius: 4px; -fx-border-color: #66c0f4; -fx-border-radius: 4px; -fx-padding: 8px;" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 5px 0 0 0;">
               <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <children>
                     <Label prefHeight="17.0" prefWidth="165.0" text="SteamAPI key (not obligatory):" />
                     <TextField fx:id="apikey" HBox.hgrow="ALWAYS" />
                  </children>
               </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ImageView fx:id="image03" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <ImageView fx:id="image04" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                    </HBox>
                </VBox>
            </HBox>
            <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 5px;">
                <Label fx:id="clickableLabel" onMouseClicked="#handleLabelClick" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"
                       text="Find my Steam ID" style="-fx-text-fill: #66c0f4; -fx-cursor: hand; -fx-underline: true;" />
                <Label fx:id="clickableLabel2" onMouseClicked="#handleLabelClick2" onMouseEntered="#handleMouseEnter4" onMouseExited="#handleMouseExit4"
                       text="More information" style="-fx-text-fill: #66c0f4; -fx-cursor: hand; -fx-underline: true;" />
            </VBox>
            <Button fx:id="confirm" defaultButton="true" mnemonicParsing="false" onAction="#confirm" onMouseEntered="#handleMouseEnter2" onMouseExited="#handleMouseExit2"
                    prefHeight="45.0" prefWidth="220.0"
                    style="-fx-background-color: linear-gradient(to bottom, #75b022, #588a1b); -fx-text-fill: #ffffff; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Confirm">
                <effect>
                    <DropShadow color="#00000080" height="6.0" radius="2.5" width="6.0" />
                </effect>
            </Button>
        </VBox>
    </center>
</BorderPane>