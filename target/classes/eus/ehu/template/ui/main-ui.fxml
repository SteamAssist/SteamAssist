                    <Label fx:id="tiktok" text="https://www.tiktok.com/@steamassist" visible="false"/>
                </VBox>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
                <VBox.margin>
                    <Insets bottom="5.0"/>
                </VBox.margin>
                <VBox alignment="CENTER" spacing="5.0">
                    <Hyperlink onAction="#showPrivacyPolicy" text="Privacy Policy"/>
                    <Hyperlink onAction="#showaboutus" text="About us"/>
                    <Hyperlink onAction="#showcontactus" text="Contact us"/>
                </VBox>
                <ImageView fitHeight="70.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../../../../logo.png"/>
                </ImageView>
            </HBox>
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="17.0" text="© 2025 Copilot Fanboys"
                   textAlignment="CENTER" HBox.hgrow="ALWAYS">
                <HBox.margin>
                    <Insets bottom="5.0" left="5.0"/>
                </HBox.margin>
                <VBox.margin>
                    <Insets bottom="5.0"/>
                </VBox.margin>
            </Label>
        </VBox>
        <Separator prefWidth="200.0"/>
    </VBox> </bottom> </BorderPane>
