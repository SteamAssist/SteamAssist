                    <Label text="\@SteamAssist"/>
                    <Label fx:id="youtube" text="https://www.youtube.com/@steamassist" visible="false"/>
                </VBox>
                <VBox alignment="CENTER">
                    <ImageView fx:id="tiktokimg" fitHeight="55.0" fitWidth="55.0"
                               onMouseClicked="#tiktokclick" onMouseEntered="#handletiktokMouseEnter"
                               onMouseExited="#handletiktokMouseExit" pickOnBounds="true"
