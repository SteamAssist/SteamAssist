<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="450.0" minWidth="550.0" prefHeight="484.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.template.ui.MainController"> <top>
    <VBox BorderPane.alignment="CENTER">
        <Separator prefWidth="200.0"/>
        <ButtonBar fx:id="buttonBar" prefHeight="74.0"
                   style="-fx-background-color: lightgray; -fx-padding: 8; -fx-spacing: 20;">
            <buttons>
                <Button fx:id="hltb_bttn" mnemonicParsing="false" onAction="#howlongtobeat"
                        onMouseEntered="#htlbMouseEnter" onMouseExited="#htlbMouseExited" prefHeight="41.0"
                        style="-fx-background-color: #3B82F6; -fx-text-fill: #FFFFFF; " text="Games duration"
                        ButtonBar.buttonData="LEFT"/>
                <Button fx:id="rg_bttn" mnemonicParsing="false" onAction="#recommend_games"
                        onMouseEntered="#recommendMouseEnter" onMouseExited="#recommendMouseExited" prefHeight="41.0"
                        style="-fx-background-color: #3B82F6; -fx-text-fill: #FFFFFF; " text="Recommendations"
                        ButtonBar.buttonData="LEFT"/>
                <Button fx:id="add_acounts_btn" mnemonicParsing="false" onAction="#addAccounts"
                        onMouseEntered="#addacountsMouseEnter" onMouseExited="#addacountsMouseExited" prefHeight="41.0"
                        style="-fx-background-color: #3B82F6; -fx-text-fill: #FFFFFF; " text="Add acounts"
                        visible="false" ButtonBar.buttonData="RIGHT"/>
                <Button fx:id="login_bttn" mnemonicParsing="false" onAction="#handleLoginButton"
                        onMouseEntered="#loginMouseEnter" onMouseExited="#loginMouseExited" prefHeight="41.0"
                        style="-fx-background-color: #10B981; -fx-text-fill: #FFFFFF;" text="Log in/Sign up"
                        ButtonBar.buttonData="RIGHT"/>
                <ComboBox fx:id="idiomaComboBox" onAction="#cambiarIdioma" prefWidth="100" />
            </buttons>
            <padding>
                <Insets left="10.0" right="10.0"/>
            </padding>
        </ButtonBar>
        <Separator prefWidth="200.0"/>
    </VBox> </top> <center>
    <StackPane BorderPane.alignment="CENTER">
        <VBox alignment="TOP_CENTER" spacing="20.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label fx:id="introtext" text="Login into SteamAssist to unlock all possibilities 🎮🎮🎮" wrapText="true">
                <font>
                    <Font size="20.0"/>
                </font>
                <VBox.margin>
                    <Insets top="20.0"/>
                </VBox.margin>
            </Label>
            <Label fx:id="li_confirm" alignment="CENTER" prefHeight="58.0" textAlignment="CENTER" wrapText="true">
                <font>
                    <Font size="20.0"/>
                </font>
            </Label>
            <HBox alignment="CENTER" spacing="10.0">
                <VBox.margin>
                    <Insets/>
                </VBox.margin>
                <Button mnemonicParsing="false" onAction="#Previous"
                        style="-fx-text-fill: #FFFFFF; -fx-background-color: #3B82F6;" text="Previous"/>
                <Label text="Account:"/>
                <Label fx:id="IDLabel" prefHeight="17.0" prefWidth="187.0"/>
                <Button mnemonicParsing="false" onAction="#Next"
                        style="-fx-background-color: #3B82F6; -fx-text-fill: #FFFFFF;" text="Next"/>
            </HBox>
        </VBox>
        <TextArea fx:id="privacyPolicyTextArea" editable="false" visible="false"/>
        <ImageView fx:id="close_btn" fitHeight="42.0" fitWidth="42.0" onMouseClicked="#close"
                   onMouseEntered="#closeenter" onMouseExited="#closeexit" pickOnBounds="true" preserveRatio="true"
                   visible="false" StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets right="10.0" top="10.0"/>
            </StackPane.margin>
            <Image url="@../../../../04.jpg"/>
        </ImageView>
    </StackPane> </center> <bottom>
    <VBox BorderPane.alignment="CENTER">
