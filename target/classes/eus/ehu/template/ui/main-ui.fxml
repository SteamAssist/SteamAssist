            </padding>
            <Label style="-fx-underline: true; -fx-font-family: 'Arial'; -fx-font-size: 20px; -fx-text-fill: #0078D7;"
                   text="Follow us on social media!!!">
                <VBox.margin>
                    <Insets left="10.0" top="5.0"/>
                </VBox.margin>
            </Label>
            <HBox alignment="CENTER" spacing="40.0">
                <VBox.margin>
                    <Insets bottom="5.0" top="5.0"/>
                </VBox.margin>
                <VBox alignment="CENTER">
                    <ImageView fx:id="instagramImage" fitHeight="55.0" fitWidth="55.0"
