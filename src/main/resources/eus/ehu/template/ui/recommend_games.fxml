<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="251.0" prefWidth="541.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.template.ui.RecommendGames">
    <ComboBox fx:id="library_or_not" layoutX="60.0" layoutY="84.0" prefHeight="29.0" prefWidth="162.0"
              promptText="Select an option" visibleRowCount="3"/>
    <RadioButton fx:id="gyhp_most" layoutX="320.0" layoutY="75.0" mnemonicParsing="false" prefHeight="17.0"
                 prefWidth="192.0" text="Games you have played most"/>
    <RadioButton fx:id="gyhp_recently" layoutX="320.0" layoutY="113.0" mnemonicParsing="false"
                 text="Games you have played recently"/>
    <Button fx:id="select" layoutX="320.0" layoutY="158.0" mnemonicParsing="false" onAction="#select_radio"
            prefHeight="25.0" prefWidth="78.0" text="Select"/>
    <Button fx:id="friend_rec" layoutX="311.0" layoutY="197.0" mnemonicParsing="false" onAction="#open_fr"
            prefHeight="43.0" prefWidth="173.0" text="Friend Recommendations"/>
    <Button fx:id="back_bttn" layoutY="1.0" mnemonicParsing="false" onAction="#back" prefHeight="25.0" prefWidth="37.0"
            text="&lt;-"/>
    <Button fx:id="logout_bttn" layoutX="475.0" layoutY="14.0" mnemonicParsing="false" onAction="#logout"
            text="Log Out"/>
</AnchorPane>
