<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="277.0" minWidth="500.0" prefHeight="400.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.template.ui.SteamAddAccountController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <Button fx:id="back" mnemonicParsing="false" onAction="#back" onMouseEntered="#handleMouseEnter3" onMouseExited="#handleMouseExit3" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #007bff; -fx-text-fill: #ffffff;" text="&lt;- Back">
                <HBox.margin>
                    <Insets bottom="10.0" left="10.0" top="10.0" />
                </HBox.margin>
            </Button>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Add Steam Account" HBox.hgrow="ALWAYS">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
                <HBox.margin>
                    <Insets bottom="10.0" right="90.0" top="10.0" />
                </HBox.margin>
            </Label>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <HBox alignment="CENTER" spacing="10.0">
                <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefHeight="17.0" prefWidth="165.0" text="Account name:" />
                        <TextField fx:id="Accountnamefield" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefHeight="17.0" prefWidth="165.0" text="Steam ID:" />
                        <TextField fx:id="id" prefHeight="25.0" prefWidth="483.0" HBox.hgrow="ALWAYS" />
                    </HBox>
               <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <children>
                     <Label prefHeight="17.0" prefWidth="165.0" text="SteamAPI key (not obligatory):" />
                     <TextField fx:id="apikey" HBox.hgrow="ALWAYS" />
                  </children>
               </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ImageView fx:id="image03" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <ImageView fx:id="image04" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                    </HBox>
                </VBox>
            </HBox>
            <VBox alignment="CENTER" spacing="10.0">
                <Label fx:id="clickableLabel" onMouseClicked="#handleLabelClick" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" text="Find my Steam ID" />
                <Label fx:id="clickableLabel2" onMouseClicked="#handleLabelClick2" onMouseEntered="#handleMouseEnter4" onMouseExited="#handleMouseExit4" text="More information" />
            </VBox>
            <Button fx:id="confirm" defaultButton="true" mnemonicParsing="false" onAction="#confirm" onMouseEntered="#handleMouseEnter2" onMouseExited="#handleMouseExit2" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #007bff; -fx-text-fill: #ffffff;" text="Confirm" />
        </VBox>
    </center>
