<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<?import javafx.scene.shape.Rectangle?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="500.0" minWidth="800.0" prefHeight="650.0" prefWidth="900.0"
            style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eus.ehu.template.ui.ShowGameHLTBController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #0f3460;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <Label text="Game Details" textFill="WHITE">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <effect>
               <DropShadow color="#00000080" height="4.0" radius="1.5" width="4.0" />
            </effect>
         </Label>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <HBox alignment="TOP_CENTER" spacing="25.0">
                  <VBox.margin>
                     <Insets bottom="10.0" top="10.0" />
                  </VBox.margin>
                  <VBox alignment="CENTER" maxWidth="300.0" HBox.hgrow="NEVER">
                     <StackPane>
                        <ImageView fx:id="image" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
                           <effect>
                              <DropShadow />
                           </effect>
                        </ImageView>
                        <Rectangle arcHeight="10.0" arcWidth="10.0" fill="TRANSPARENT" height="250.0" stroke="#e94560" strokeWidth="3.0" width="250.0" />
                     </StackPane>
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                     <Label fx:id="price" alignment="CENTER" contentDisplay="CENTER" style="-fx-background-color: #e94560; -fx-background-radius: 5;" textFill="WHITE">
                        <font>
                           <Font name="System Bold" size="18.0" />
                        </font>
                        <padding>
                           <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
                        </padding>
                        <VBox.margin>
                           <Insets top="15.0" />
                        </VBox.margin>
                     </Label>
                  </VBox>
                  <VBox alignment="TOP_LEFT" spacing="15.0" HBox.hgrow="ALWAYS">
                     <Label fx:id="title" textFill="WHITE" wrapText="true">
                        <font>
                           <Font name="System Bold" size="28.0" />
                        </font>
                        <effect>
                           <DropShadow />
                        </effect>
                     </Label>
                     <TextArea fx:id="description" editable="false" prefHeight="150.0" style="-fx-background-color: rgba(15, 52, 96, 0.7); -fx-text-fill: white; -fx-background-radius: 10;" wrapText="true">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </TextArea>
                  </VBox>
               </HBox>

               <VBox style="-fx-background-color: rgba(15, 52, 96, 0.7); -fx-background-radius: 10;" spacing="15.0">
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  <Label text="How Long To Beat" textFill="#e94560">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>

                  <GridPane hgap="15.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="200.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="200.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                     </rowConstraints>

                     <VBox alignment="CENTER" style="-fx-background-color: rgba(233, 69, 96, 0.2); -fx-background-radius: 8;">
                        <padding>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label text="Main Story" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="mainLength" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <graphic>
                              <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                 <Image url="@../../../../eye.png" />
                              </ImageView>
                           </graphic>
                        </Label>
                     </VBox>

                     <VBox alignment="CENTER" style="-fx-background-color: rgba(233, 69, 96, 0.2); -fx-background-radius: 8;" GridPane.columnIndex="1">
                        <padding>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label text="Main + Sides" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="mainSidesLength" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <graphic>
                              <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                 <Image url="@../../../../eye.png" />
                              </ImageView>
                           </graphic>
                        </Label>
                     </VBox>

                     <VBox alignment="CENTER" style="-fx-background-color: rgba(233, 69, 96, 0.2); -fx-background-radius: 8;" GridPane.rowIndex="1">
                        <padding>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label text="Completionist" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="completeLength" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <graphic>
                              <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                 <Image url="@../../../../eye.png" />
                              </ImageView>
                           </graphic>
                        </Label>
                     </VBox>

                     <VBox alignment="CENTER" style="-fx-background-color: rgba(233, 69, 96, 0.2); -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <padding>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label text="All Styles" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="allLength" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <graphic>
                              <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                 <Image url="@../../../../eye.png" />
                              </ImageView>
                           </graphic>
                        </Label>
                     </VBox>
                  </GridPane>
               </VBox>

               <HBox alignment="CENTER" spacing="15.0">
                  <VBox.margin>
                     <Insets top="10.0" />
                  </VBox.margin>
                  <Button mnemonicParsing="false" onAction="#back" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 5;" text="Back to Games List">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                     <effect>
                        <DropShadow height="5.0" radius="2.0" width="5.0" />
                     </effect>
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <Image url="@../../../../atras.png" />
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 5;" text="Add to Favorites">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                     <effect>
                        <DropShadow height="5.0" radius="2.0" width="5.0" />
                     </effect>
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <Image url="@../../../../eye.png" />
                        </ImageView>
                     </graphic>
                  </Button>
               </HBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" style="-fx-background-color: #0f3460;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <Label text="© 2025 Copilot Fanboys - SteamAssist" textFill="WHITE">
            <font>
               <Font size="12.0" />
            </font>
         </Label>
      </HBox>
   </bottom>
</BorderPane>