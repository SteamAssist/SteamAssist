<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="277.0" prefWidth="719.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.template/ui.Login">
    <ImageView fitHeight="195.0" fitWidth="542.0" layoutX="267.0" layoutY="47.0" pickOnBounds="true"
               preserveRatio="true"/>
    <Label layoutX="14.0" layoutY="119.0" prefHeight="25.0" prefWidth="93.0" text="Account name:"/>
    <Label layoutX="21.0" layoutY="161.0" prefHeight="25.0" prefWidth="79.0" text="Password:"/>
    <TextField fx:id="account_name" layoutX="107.0" layoutY="119.0"/>
    <TextField fx:id="password" layoutX="107.0" layoutY="161.0"/>
    <Button fx:id="login_bttn" layoutX="21.0" layoutY="204.0" mnemonicParsing="false" onAction="#login"
            prefHeight="37.0" prefWidth="93.0" text="Login"/>
    <Label fx:id="success_btn" layoutX="147.0" layoutY="214.0" prefHeight="17.0" prefWidth="93.0" text="Success"/>
    <Button fx:id="back_bttn" layoutY="1.0" mnemonicParsing="false" onAction="#back" prefHeight="25.0" prefWidth="31.0"
            text="&lt;-"/>
</AnchorPane>